pipeline {
  agent any

  tools {
    nodejs 'NodeJS-18'
  }

  environment {
    SONAR_HOST_URL = 'http://192.168.251.30:9000'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install Dependencies') {
      steps {
        dir('Application-Code') {
          sh 'yarn install'
        }
      }
    }

    stage('Build React App') {
      steps {
        dir('Application-Code') {
          sh 'yarn build'
        }
      }
    }

stage('SonarQube Scan') {
  steps {
    dir('Application-Code') {
      withSonarQubeEnv('sonar') {
        sh '''
          ${tool 'sonar-scanner'}/bin/sonar-scanner \
          -Dsonar.projectKey=netflix-react \
          -Dsonar.sources=src \
          -Dsonar.host.url=http://192.168.251.30:9000
        '''
      }
    }
  }
}

    stage('OWASP Dependency Check') {
      steps {
        dir('Application-Code') {
          sh 'dependency-check --project netflix-react --scan .'
        }
      }
    }
  }
}

